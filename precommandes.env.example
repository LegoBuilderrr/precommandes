# Copier en precommandes.env (jamais versionné) et remplir.
# Adresse publique de l'application, avec son éventuel préfixe (sert aux adresses de retour HelloAsso et à la protection CSRF).
BASE_URL=https://codexprod.fr/precommandes
# Mot de passe partagé de secours de l'administration (identifiant « admin »). Les comptes des membres viennent de users.json
# (scripts/export-users.js). Sans compte et sans mot de passe, l'administration est ouverte : seulement en local.
ADMIN_PASSWORD=changez-moi
# Clés de l'API HelloAsso (sandbox).
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Optionnel : HELLOASSO_API=https://api.helloasso.com (production) et HELLOASSO_ORG=l-elefan
